page {
  background-color: var(--background-color);
}

.account-content {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-account-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  font-size: 80rpx;
  color: white;
}

.detail-account-name {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  max-width: 80vw;
  overflow: hidden;
  
}

.detail-account-description {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 72rpx;
  max-width: 80vw;
  text-align: center;
}

.detail-code-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 72rpx;
}

.detail-verification-code {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--primary-color);
  margin-bottom: 32rpx;
}

.detail-timer-container {
  width: 120rpx;
  height: 120rpx;
  position: relative;
}

.detail-timer-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(var(--primary-color) var(--progress), #e0e0e0 0deg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-timer-text {
  font-size: 48rpx;
  font-weight: 500;
  color: #ffffff;
}

.detail-actions {
  display: flex;
  margin-top: 48rpx;
  width:100%;
  justify-content:space-around;
}

.detail-action-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background-color: transparent;
  transition: var(--transition);
  border: none;
  cursor: pointer;
}

.detail-action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background-color: var(--card-color);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--box-shadow);
}

.detail-action-icon .action-icon {
  width: 48rpx;
  height: 48rpx;
}

.detail-action-icon i {
  font-size: 48rpx;
  color: var(--primary-color);
}

.detail-action-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}