/* pages/setting/setting.wxss */
.settings-content {
  padding: 48rpx 32rpx;
}

.settings-account-info {
  display: flex;
  align-items: center;
  /* margin-bottom: 64rpx; */
}

.settings-account-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  color: white;
  font-size: 64rpx;
}

.settings-account-text {
  flex-grow: 1;
}

.settings-account {
  font-size: 32rpx;
  padding-bottom: 8rpx;
}

.settings-account-email {
  font-size: 28rpx;
  color: var(--text-secondary);
  max-width: 60vw;
}

.settings-section {
  margin-bottom: 48rpx;
}

.settings-section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.settings-form-group {
  background-color: var(--card-color);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.settings-form-label {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.settings-form-input {
  /* width: 100%; */
  border: 2rpx solid rgba(0, 0, 0, 0.1);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  font-size: 32rpx;
  color: var(--text-primary);
  background-color: transparent;
  outline: none;
}

.settings-form-input:focus {
  border-color: var(--primary-color);
}

.settings-danger-zone {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.05);
}

.settings-danger-button {
  background-color: var(--danger-color);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  font-size: 32rpx;
  width: 100% !important;
  text-align: center;
  cursor: pointer;
  font-weight: 500;
}

.settings-danger-button:active {
  opacity: 0.85;
}

.settings-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100vw;
  padding: 48rpx 0;
  background-color: var(--card-color);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 960;
  display: flex;
  justify-content: center;
}

.save-button {
  background-color: var(--primary-color);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 32rpx;
  text-align: center;
  cursor: pointer;
  font-weight: 500;
  box-shadow: 0 8rpx 16rpx rgba(66, 133, 244, 0.2);
  transition: var(--transition);
  width: 600rpx !important;
}

.save-button:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.save-button[disabled]:active {
  transform: scale(1);
  opacity: 1;
}