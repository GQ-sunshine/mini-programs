/* wxss */
.account-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-bottom: 160rpx;
}

.account-card {
  background-color: var(--card-color);
  border-radius: var(--border-radius);
  padding: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--box-shadow);
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.account-card:active {
  transform: scale(0.98);
}

.account-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background-color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  flex-shrink: 0;
  color: white;
  font-size: 48rpx;
}

.account-info {
  flex-grow: 1;
}

.account-name {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  color: var(--text-primary);
  max-width: 65vw;
}

.account-description {
  font-size: 28rpx;
  color: var(--text-secondary);
  max-width: 80vw;
}

.no-accounts {
  font-size: 28rpx;
  margin-bottom: 8rpx;
  color: var(--text-secondary);
  text-align: center;
  padding-top: 120rpx;
}